[Desktop Entry]
Name=Netflix
GenericName=Streaming Video
Exec=env GTK_THEME=carbon-chromium-gtk /usr/bin/chromium --ozone-platform=wayland --gtk-version=4 --app=https://www.netflix.com
StartupNotify=true
StartupWMClass=chrome-www.netflix.com__-Default
Terminal=false
Icon=netflix
Type=Application
Categories=AudioVideo;Video;Player;

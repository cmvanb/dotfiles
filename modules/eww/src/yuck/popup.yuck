;;------------------------------------------------------------------------------
;; Popup
;;
;; A transparent, full-width window under the bar, opened by scripts/popup.sh
;; with --arg name=<panel> --arg output=<output>. It holds a hidden copy of the
;; bar's status modules (see `status-modules`), which positions the panel
;; under the module that opened it. Clicking beside the panel dismisses it.
;;------------------------------------------------------------------------------

(defwindow popup [name output]
  :geometry (geometry :x "0px" :y "6px" :width "100%" :anchor "top center")
  :stacking "overlay"
  :focusable "none"
  :namespace "eww-popup"
  (eventbox :onclick "scripts/popup.sh dismiss"
    (box :class "popup-row" :orientation "v" :space-evenly false
      (status-modules :output output :open name))))

;; The panel renders the matching `<name>-panel` widget. `leave` waits out a
;; grace period, longer than eww's 200ms command timeout, so it runs detached.
(defwidget popup-panel [name halign]
  (eventbox :halign halign
            :onhover "eww update popup_hover=true"
            :onhoverlost "eww update popup_hover=false; scripts/popup.sh leave &"
    (box :class "panel" :orientation "v" :space-evenly false
      (literal :content "(${name}-panel)"))))

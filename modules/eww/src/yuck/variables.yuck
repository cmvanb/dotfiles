;;------------------------------------------------------------------------------
;; Variables
;;------------------------------------------------------------------------------

;; Popup state, managed by scripts/popup.sh
(defvar popup "")
(defvar popup_hover false)

;; Calendar view, pushed by scripts/month-grid.py
(defvar calendar '{"view":"month","offset":0,"year_offset":0,"title":"","current":true,"weekdays":[],"weeks":[],"months":[]}')

;; Event-driven listeners
(deflisten sway
  :initial '{"mode":"default","outputs":{}}'
  "scripts/sway.py")

(deflisten audio
  :initial '{"volume":0,"muted":false,"mic_volume":0,"mic_muted":false,"sinks":[]}'
  "scripts/audio.sh")

(deflisten network
  :initial '{"type":"none","iface":"","name":"","signal":0,"ip":"","gateway":"","wifi_enabled":false}'
  "scripts/network.sh")

(deflisten bluetooth
  :initial '{"powered":false,"connected":0,"devices":[]}'
  "scripts/bluetooth.sh")


;; Polled state
(defpoll battery
  :interval "5s"
  :initial '{"present":false,"capacity":0,"status":"","icon":"","watts":0,"remaining":"","health":0,"cycles":0}'
  "scripts/battery.sh")

(defpoll tailscale
  :interval "10s"
  :initial '{"up":false,"name":"","ip":"","peers":[]}'
  "scripts/tailscale.sh")

(defpoll claude
  :interval "60s"
  :initial '{"ok":false,"session":0,"session_reset":"","week":0,"week_reset":"","extra_used":0,"extra_limit":0,"extra":0,"currency":""}'
  "scripts/claude.sh")

(defpoll openrouter
  :interval "60s"
  :initial '{"ok":false,"has_budget":false,"budget":0,"budget_spent":"","budget_limit":"","budget_reset":"","has_credits":false,"credits":0,"credits_left":"","credits_total":"","today":"","week":"","month":""}'
  "scripts/openrouter.sh")

;; Time zone name; formattime's %Z only yields the UTC offset
(defpoll timezone
  :interval "10m"
  :initial "UTC"
  "timedatectl show -p Timezone --value")

;; Polled only while their popup is open
(defpoll processes_cpu
  :interval "3s"
  :initial "[]"
  :run-while {popup == "cpu"}
  "scripts/processes.sh cpu")

(defpoll processes_memory
  :interval "3s"
  :initial "[]"
  :run-while {popup == "memory"}
  "scripts/processes.sh mem")

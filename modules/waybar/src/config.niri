{
    "layer": "top",
    "height": 20,
    "margin-top": 6,

    "modules-left": ["niri/workspaces"],
    "modules-center": ["niri/window"],
    "modules-right": ["custom/updates", "network", "bluetooth", "wireplumber", "battery", "clock"],

    "custom/updates": {
        "exec": "$XDG_CONFIG_HOME/waybar/updates.sh",
        "return-type": "json",
        "interval": 30,
        "on-click": "$XDG_SCRIPTS_HOME/spawn-terminal.sh -f -t 'System Update' -c sysupdate"
    },

    "niri/window": {
        "format": "{}"
    },

    "niri/workspaces": {
        "format": "{icon} {value}",
        "format-icons": {
            // Icons by state
            "active": " ",
            "default": " "
        }
    },

    "network": {
        "format-ethernet": "󰲝   {ifname}",
        "format-wifi": "󰖩   {ifname}",
        "format-disconnected": "󰲜   no network",
        "tooltip": true,
        "tooltip-format": "{gwaddr} · {bandwidthUpBytes} up · {bandwidthDownBytes} down"
    },

    "bluetooth": {
        "format": "  {status}",
        "tooltip": true,
        "tooltip-format": "{controller_alias}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias} · {device_address}",
        "tooltip-format-disabled": "controller disabled",
        "tooltip-format-off": "controller off"
    },

    "wireplumber": {
        "format": "{icon}   {volume}%",
        "format-muted": "󰝟   {volume}%",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute 167 toggle"
    },

    "battery": {
        "format": "{icon}    {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "interval": 5,
        "states": {
            "warning": 30,
            "critical": 15
        }
    },

    "clock": {
        "format": "󰸘   {:%Y-%m-%d        %H:%M}"
    }
}

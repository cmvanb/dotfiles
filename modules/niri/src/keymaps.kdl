//------------------------------------------------------------------------------
// Niri key mappings
//  see: https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings
//------------------------------------------------------------------------------

binds {
    // System mappings
    //--------------------------------------------------------------------------

    // Lock niri
    Mod+Shift+Z { spawn "hyprlock"; }

    // System menu (lock / log out / suspend / reboot / reboot to Windows / shutdown)
    Mod+Shift+X { spawn "system-menu.sh"; }

    // Toggle between the dark and light color schemes
    Mod+Shift+C { spawn "theme" "switch" "toggle"; }

    // Reload niri configuration
    Mod+Shift+R { spawn-sh "$XDG_CONFIG_HOME/niri/scripts/reload.sh"; }

    // Shortcut mappings
    //--------------------------------------------------------------------------

    // Run menu
    Mod+Return { spawn-sh "$LAUNCHER"; }

    // New terminal
    Mod+T { spawn "spawn-terminal.sh"; }

    // New terminal in a directory
    Mod+Shift+T { spawn "open-terminal-cwd.sh"; }

    // New floating terminal
    Mod+G { spawn "spawn-terminal.sh" "--floating"; }

    // New floating terminal in a directory
    Mod+Shift+G { spawn "open-terminal-cwd.sh" "--floating"; }

    // Browser
    Mod+B { spawn-sh "$BROWSER"; }

    // Browser session
    Mod+Shift+B { spawn "open-browser-session.sh"; }

    // Workspace session
    Mod+Shift+S { spawn-sh "$XDG_CONFIG_HOME/niri/scripts/wsesh.sh select"; }

    // Process manager
    Mod+M { spawn "spawn-terminal.sh" "--command" "btop"; }

    // Volume control
    Mod+V { spawn-sh "$XDG_CONFIG_HOME/niri/scripts/open-pavucontrol.sh"; }

    // Toggle the eww bar
    Mod+R { spawn "eww-bar.sh" "toggle"; }

    // Dismiss all notifications
    Mod+Y { spawn "swaync-client" "--close-all"; }

    // Toggle notification center
    Mod+Shift+Y { spawn "swaync-client" "--toggle-panel" "--skip-wait"; }

    // Take screenshot of a selected rectangle
    Mod+P { spawn "screenshot-rectangle.sh"; }

    // Wooz
    Mod+Shift+P { spawn "wooz"; }

    // TODO: Generalize to configured coding agent.
    // Open Claude Code in a floating terminal at a zoxide directory
    Mod+A { spawn "open-claude-cwd.sh"; }

    // Open claude.ai
    Mod+Shift+A { spawn "qutebrowser" "--target" "window" ":session-load claude"; }

    // Toggle dictation (whisrs)
    Mod+D { spawn "whisrs" "toggle"; }

    // Cancel dictation
    Mod+Shift+D { spawn "whisrs" "cancel"; }

    // Window mappings
    //--------------------------------------------------------------------------

    // Toggle window float
    Mod+Space { toggle-window-floating; }

    // Center window
    Mod+C { center-window; }

    // Cycle column width
    Mod+F { switch-preset-column-width; }

    // Toggle window fullscreen
    Mod+Alt+F { fullscreen-window; }

    // Close window
    Mod+W { close-window; }
    Mod+MouseMiddle { close-window; }

    // Change focus
    Mod+J { focus-window-or-monitor-down; }
    Mod+K { focus-window-or-monitor-up; }
    Mod+H { focus-column-or-monitor-left; }
    Mod+L { focus-column-or-monitor-right; }

    // Cycle windows with the scroll wheel
    Mod+WheelScrollDown { focus-window-down-or-column-right; }
    Mod+WheelScrollUp { focus-window-up-or-column-left; }

    // Move focused window
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+H { move-column-left-or-to-monitor-left; }
    Mod+Ctrl+L { move-column-right-or-to-monitor-right; }

    // Move the focused window to the previous or next monitor
    Mod+Ctrl+Shift+H { move-window-to-monitor-previous; }
    Mod+Ctrl+Shift+L { move-window-to-monitor-next; }

    // Resize window
    Mod+Alt+K { set-window-height "-100"; }
    Mod+Alt+J { set-window-height "+100"; }
    Mod+Alt+L { set-window-width "+200"; }
    Mod+Alt+H { set-window-width "-200"; }

    // Move the window into or out of the column on the left
    Mod+S { consume-or-expel-window-left; }

    // Workspace mappings
    //--------------------------------------------------------------------------

    // Toggle the overview
    Mod+E { toggle-overview; }

    // Focus the most recent occupied workspace
    Mod+Semicolon { spawn "niri-ws" "back"; }

    // Move the focused window to the most recent occupied workspace
    Mod+Ctrl+Semicolon { spawn "niri-ws" "back" "--move"; }

    // Rename the focused workspace
    Mod+Shift+N { spawn-sh "$XDG_CONFIG_HOME/niri/scripts/rename-workspace.sh"; }

    // Cycle occupied workspaces
    Mod+Shift+J { spawn "niri-ws" "step" "down"; }
    Mod+Shift+K { spawn "niri-ws" "step" "up"; }
    Mod+Shift+WheelScrollDown { spawn "niri-ws" "step" "down"; }
    Mod+Shift+WheelScrollUp { spawn "niri-ws" "step" "up"; }

    // Move the focused window to the previous or next occupied workspace
    Mod+Ctrl+Shift+J { spawn "niri-ws" "step" "down" "--move"; }
    Mod+Ctrl+Shift+K { spawn "niri-ws" "step" "up" "--move"; }

    // Focus a fresh workspace
    Mod+O { spawn "niri-ws" "fresh"; }

    // Move the focused window to a fresh workspace
    Mod+Ctrl+O { spawn "niri-ws" "fresh" "--move"; }

    // Focus special workspaces
    Mod+F1 { focus-workspace "home"; }
    Mod+F2 { focus-workspace "mail"; }
    Mod+F3 { focus-workspace "todo"; }
    Mod+F4 { focus-workspace "vim"; }
    Mod+F5 { focus-workspace "auth"; }
    Mod+F6 { focus-workspace "system"; }
    Mod+F7 { focus-workspace "config"; }
    Mod+F8 { focus-workspace "dev"; }
    Mod+F9 { focus-workspace "project"; }
    Mod+F10 { focus-workspace "ssh"; }
    Mod+F11 { focus-workspace "chat"; }
    Mod+F12 { focus-workspace "audio"; }

    // Send to special workspaces
    Mod+Ctrl+F1 { move-window-to-workspace "home" focus=false; }
    Mod+Ctrl+F2 { move-window-to-workspace "mail" focus=false; }
    Mod+Ctrl+F3 { move-window-to-workspace "todo" focus=false; }
    Mod+Ctrl+F4 { move-window-to-workspace "vim" focus=false; }
    Mod+Ctrl+F5 { move-window-to-workspace "auth" focus=false; }
    Mod+Ctrl+F6 { move-window-to-workspace "system" focus=false; }
    Mod+Ctrl+F7 { move-window-to-workspace "config" focus=false; }
    Mod+Ctrl+F8 { move-window-to-workspace "dev" focus=false; }
    Mod+Ctrl+F9 { move-window-to-workspace "project" focus=false; }
    Mod+Ctrl+F10 { move-window-to-workspace "ssh" focus=false; }
    Mod+Ctrl+F11 { move-window-to-workspace "chat" focus=false; }
    Mod+Ctrl+F12 { move-window-to-workspace "audio" focus=false; }

    // Laptop keys
    //--------------------------------------------------------------------------

    // Volume
    XF86AudioRaiseVolume allow-when-locked=true { spawn "volume.sh" "raise"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "volume.sh" "lower"; }
    XF86AudioMute allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }

    // Brightness
    XF86MonBrightnessUp allow-when-locked=true { spawn "swayosd-client" "--brightness" "raise"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "swayosd-client" "--brightness" "lower"; }

    // Caps Lock indicator: niri has no release binds, so swayosd misses the LED state.
}

//------------------------------------------------------------------------------
// Niri configuration
//  see: https://github.com/YaLTeR/niri/wiki/Configuration:-Overview
//------------------------------------------------------------------------------

// General settings
//------------------------------------------------------------------------------

prefer-no-csd

screenshot-path "~/Media/Images/screenshots/niri--%Y-%m-%d--%H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

// Input
//  see: https://github.com/YaLTeR/niri/wiki/Configuration:-Input
//------------------------------------------------------------------------------

// niri has no per-device pointer settings, so mice keep the libinput defaults.
input {
    keyboard {
        repeat-delay 300
        repeat-rate 50

        // custom:fkeys restores F13-F15 keysyms (see xkb module)
        xkb {
            options "custom:fkeys"
        }
    }

    touchpad {
        tap
        natural-scroll
    }

    focus-follows-mouse max-scroll-amount="0%"
}

// Layout
//  see: https://github.com/YaLTeR/niri/wiki/Configuration:-Layout
//------------------------------------------------------------------------------

layout {
    gaps 6

    // Workspaces show the wallpaper, which lives in the backdrop (see layer rules).
    background-color "transparent"

    center-focused-column "always"

    preset-column-widths {
        proportion 0.333333
        proportion 0.5
        proportion 0.666667
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.333333
        proportion 0.5
        proportion 0.666667
        proportion 1.0
    }

    default-column-width { proportion 0.36; }

    focus-ring {
        off
    }

    border {
        width 3
    }
}

// Environment
//------------------------------------------------------------------------------

environment {
    // Cursor theme path
    XCURSOR_PATH "/usr/share/icons"

    // Qt performance flag
    QT_QPA_PLATFORM "wayland"
    QT_SCALE_FACTOR_ROUNDING_POLICY "round"

    // libadwaita ignores the gsettings gtk-theme-name. `carbon-gtk` is an
    // alias for the active variant, repointed by `theme switch`.
    GTK_THEME "carbon-gtk"

    // Qt apps read the carbon Qt theme through qt6ct, which follows `theme switch`.
    QT_QPA_PLATFORMTHEME "qt6ct"
}

// Layer rules
//------------------------------------------------------------------------------

layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

// Includes
//------------------------------------------------------------------------------

include optional=true "outputs.kdl"
include "theme.kdl"
include "winrules.kdl"
include "keymaps.kdl"

// Startup
//------------------------------------------------------------------------------

// Adjust screen brightness
spawn-at-startup "wlsunset" "-l" "52.155472" "-L" "5.389358"

// Clean home
spawn-sh-at-startup "$XDG_SCRIPTS_HOME/clean-home.sh"

// Apply wallpaper
spawn-at-startup "waypaper" "--restore"

// Start the eww bar (follows output hotplug)
spawn-at-startup "eww-bar.sh" "start"

// Named workspace rules
spawn-sh-at-startup "$XDG_CONFIG_HOME/niri/scripts/workspaces.sh daemon"

// Default workspace session
spawn-sh-at-startup "$XDG_CONFIG_HOME/niri/scripts/wsesh.sh launch default"

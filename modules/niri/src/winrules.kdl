//------------------------------------------------------------------------------
// Niri window rules
//  see: https://github.com/YaLTeR/niri/wiki/Configuration:-Window-Rules
//------------------------------------------------------------------------------

// Workspaces
//------------------------------------------------------------------------------

window-rule {
    match app-id=r#"^org\.gnome\.Geary$"#

    open-on-workspace "mail"
}

window-rule {
    match app-id=r#"^discord$"#
    match app-id=r#"^com\.tosta\.zapzap$"#

    open-on-workspace "chat"
}

window-rule {
    match app-id=r#"^Bitwarden$"#

    open-on-workspace "auth"
}

window-rule {
    match app-id=r#"^spotify$"#
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#

    open-on-workspace "audio"
}

// Borders
//------------------------------------------------------------------------------

window-rule {
    // GTK4 lacks xdg-decoration, so niri would draw the border as a solid
    // background that shows through Ghostty's background-opacity.
    match app-id=r#"^com\.mitchellh\.ghostty(\.floating)?$"#

    draw-border-with-background false
}

// Floating windows
//------------------------------------------------------------------------------

window-rule {
    // ffplay is X11-only: it needs xwayland-satellite to run under niri.
    match app-id=r#"^ffplay$"#
    match app-id=r#".*floating"#
    match app-id=r#"^gcr-prompter$"#
    match app-id=r#"^imv$"#
    match app-id=r#"^org\.gnome\.seahorse\.Application$"#
    match app-id=r#"^com\.transmissionbt\.transmission.*"#
    match app-id=r#"^transmission-gtk$"#
    match app-id=r#"^xdg-desktop-portal-gtk$"#
    match app-id=r#"^yad$"#
    match app-id=r#"^nm-connection-editor$"#

    open-floating true
}

window-rule {
    match app-id=r#"^blueman-manager$"#

    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id=r#"^mpv$"#

    open-floating true
    default-floating-position x=560 y=315 relative-to="top-left"
}

window-rule {
    match app-id=r#"^nwg-look$"#

    open-floating true
    default-column-width { fixed 1024; }
    default-window-height { fixed 960; }
}

window-rule {
    match app-id=r#"^thunar$"#

    open-floating true
    default-column-width { fixed 1200; }
    default-window-height { fixed 900; }
}

window-rule {
    match app-id=r#"^waypaper$"#

    default-column-width { fixed 900; }
    default-window-height { fixed 1200; }
}

window-rule {
    match app-id=r#"^org\.pwmt\.zathura$"#

    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 1200; }
}

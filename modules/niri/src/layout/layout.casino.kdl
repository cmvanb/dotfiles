//------------------------------------------------------------------------------
// Niri layout overrides - casino (laptop)
//------------------------------------------------------------------------------

layout {
    // Replaces the presets in config.kdl (preset-column-widths does not merge).
    preset-column-widths {
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }

    default-column-width { proportion 0.5; }
}

{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@ex-machina/opencode-anthropic-auth@next"
  ],
  "provider": {
    "llama-cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "gpt-oss-20b-mxfp4": {
          "name": "GPT-OSS 20B mxfp4 (local)",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        }
      }
    }
  },
  "model": "llama-cpp/gpt-oss-20b-mxfp4",
  "autoupdate": false,
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/Code/**": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.local/share/keyrings/**": "deny",
      "~/.local/share/opencode/auth.json": "deny",
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*.ssh/*": "deny",
      "*.gnupg/*": "deny",
      "*.aws/*": "deny",
      "*.netrc": "deny",
      "*.git-credentials": "deny",
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.ssh/*": "deny",
      "*.gnupg/*": "deny",
      "*.git/hooks/*": "ask",
    },
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "doas *": "ask",
      "su *": "ask",
      "pacman *": "ask",
      "systemctl *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "pkill *": "ask",
      "rm -*": "ask",
      "git push *": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "*.env": "deny",
      "*.env *": "deny",
      "*.ssh/*": "deny",
      "*.gnupg/*": "deny",
      "*.aws/*": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "printenv*": "deny",
    },
    "webfetch": "ask",
    "websearch": "allow",
    "codesearch": "allow",
  }
}

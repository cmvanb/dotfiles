{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "carbon"
  },
  "animations": true,
  "keybinds": {
    "leader": "ctrl+o",
    "session.line.up": "ctrl+alt+y,ctrl+up",
    "session.line.down": "ctrl+alt+e,ctrl+down"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show"
  }
}
